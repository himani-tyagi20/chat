# Copy to .env and edit. Every value is optional — these are the defaults.
#   cp .env.example .env
# Docker Compose reads .env automatically; for a local (non-Docker) run, export them
# or prefix the uvicorn command.

# --- Answering ---------------------------------------------------------------
# Cosine floor for "this is in the document". Below it, the service abstains.
# Measured on bge-small: on-topic 0.78-0.90, off-topic 0.36-0.50. Lower = fewer
# abstentions but more wrong answers. Re-measure this against your own corpus.
MIN_SCORE=0.62

# How many chunks are retrieved per question.
TOP_K=5

# --- Chunking (applied at ingest; re-upload the PDF after changing) ----------
CHUNK_CHARS=1000
CHUNK_OVERLAP=150

# --- Embeddings --------------------------------------------------------------
# Any fastembed ONNX model. Changing this changes the vector size, so documents
# ingested under the old model must be re-uploaded.
EMBED_MODEL=BAAI/bge-small-en-v1.5

# --- LLM mode ----------------------------------------------------------------
# Which open-source model Ollama serves. qwen2.5 is ~4.7 GB; qwen2.5:3b is ~1.9 GB
# and is plenty when answering from a few retrieved chunks. Reasoning variants
# (qwen3, deepseek-r1) work too — their <think> blocks are stripped.
# Used by both the app and the one-shot pull, so they can't drift apart.
OLLAMA_MODEL=qwen2.5

# --- Service wiring ----------------------------------------------------------
# Host port the app is published on.
APP_PORT=8000

# Only override these when pointing at services outside this compose file.
# QDRANT_URL=http://qdrant:6333
# OLLAMA_URL=http://ollama:11434
